# ── Servidor ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL ─────────────────────────────────────────────
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
# `npm run db:init` crea la base si no existe.
DATABASE_URL=postgres://postgres:TU_PASSWORD@localhost:5432/lumen_db

# ── Seguridad ──────────────────────────────────────────────
# Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-o-mas-caracteres
JWT_EXPIRES_IN=12h

# ── CORS / URLs ────────────────────────────────────────────
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173
# URL pública del front: se usa para armar el enlace público de cada boleto
PUBLIC_APP_URL=http://localhost:5173

# ── Admin inicial (lo crea `npm run db:seed`) ──────────────
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
# Mínimo 12 caracteres, sin claves comunes ni el usuario. El seed rechaza esta de ejemplo: cámbiala.
ADMIN_PASSWORD=CambiaEstaClave123!
